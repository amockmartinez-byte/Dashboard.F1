        "#dashboard personal - formula 1 🏎️\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import zipfile\n",
        "# from google.colab import files # No longer needed as file path is fixed\n",
        "\n",
        "# print(\"Sube el archivo ZIP del dataset (ultimate-f1-2023-dataset.zip)\") # No longer needed\n",
        "# uploaded = files.upload() # No longer needed\n",
        "\n",
        "# zip_filename = list(uploaded.keys())[0] # No longer needed\n",
        "zip_filename = \"/content/archive.zip\" # Use the provided file path\n",
        "extract_path = \"/content/f1_dataset/\"\n",
        "\n",
        "# Create the directory if it doesn't exist\n",
        "import os\n",
        "os.makedirs(extract_path, exist_ok=True)\n",
        "\n",
        "with zipfile.ZipFile(zip_filename, 'r') as zip_ref:\n",
        "    zip_ref.extractall(extract_path)\n",
        "\n",
        "print(\"Archivo descomprimido correctamente en:\", extract_path)\n",
        "\n",
        "drivers = pd.read_csv(extract_path + \"drivers.csv\")\n",
        "constructors = pd.read_csv(extract_path + \"constructors.csv\")\n",
        "circuits = pd.read_csv(extract_path + \"circuits.csv\")\n",
        "races = pd.read_csv(extract_path + \"races.csv\")\n",
        "results = pd.read_csv(extract_path + \"results.csv\")\n",
        "lap_times = pd.read_csv(extract_path + \"lap_times.csv\")\n",
        "pit_stops = pd.read_csv(extract_path + \"pit_stops.csv\")\n",
        "\n",
        "print(\"CSV cargados correctamente.\")\n",
        "datasets = {\n",
        "    \"drivers\": drivers,\n",
        "    \"constructors\": constructors,\n",
        "    \"circuits\": circuits,\n",
        "    \"races\": races,\n",
        "    \"results\": results,\n",
        "    \"lap_times\": lap_times,\n",
        "    \"pit_stops\": pit_stops\n",
        "}\n",
        "\n",
        "for name, df in datasets.items():\n",
        "    print(f\"Dataset: {name} - Filas: {df.shape[0]}, Columnas: {df.shape[1]}\")\n",
        "\n",
        "merged = results.merge(drivers, on=\"driverId\") \\\n",
        "                .merge(constructors, on=\"constructorId\") \\\n",
        "                .merge(races, on=\"raceId\")\n",
        "\n",
        "print(\"Tablas unidas correctamente.\")\n",
        "\n",
        "points_2023 = merged.groupby(\"surname\")[\"points\"].sum().sort_values(ascending=False)\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "points_2023.head(10).plot(kind=\"bar\")\n",
        "plt.title(\"Top 10 Pilotos con más Puntos en 2023\")\n",
        "plt.ylabel(\"Puntos\")\n",
        "plt.xlabel(\"Piloto\")\n",
        "plt.show()\n",
        "\n",
        "constructor_points = merged.groupby(\"name_y\")[\"points\"].sum().sort_values(ascending=False)\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "constructor_points.plot(kind=\"bar\")\n",
        "plt.title(\"Puntos por Constructor (2023)\")\n",
        "plt.ylabel(\"Puntos\")\n",
        "plt.xlabel(\"Constructor\")\n",
        "plt.show()\n",
        "\n",
        "avg_positions = merged.groupby(\"surname\")[\"position\"].mean().sort_values()\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "avg_positions.head(10).plot(kind=\"bar\")\n",
        "plt.title(\"Mejores Posiciones Promedio\")\n",
        "plt.ylabel(\"Posición Promedio\")\n",
        "plt.xlabel(\"Piloto\")\n",
        "plt.show()\n",
        "\n",
        "pit_avg = pit_stops.groupby(\"raceId\")[\"stop\"].count()\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "pit_avg.plot()\n",
        "plt.title(\"Número de Pit Stops por Carrera\")\n",
        "plt.ylabel(\"Pit Stops\")\n",
        "plt.xlabel(\"Carrera\")\n",
        "plt.show()\n",
        "\n",
        "lap_avg = lap_times.groupby(\"driverId\")[\"milliseconds\"].mean().sort_values()\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "lap_avg.head(10).plot(kind=\"bar\")\n",
        "plt.title(\"Promedio de Vuelta más Rápido (ms)\")\n",
        "plt.ylabel(\"Tiempo (ms)\")\n",
        "plt.xlabel(\"Piloto\")\n",
        "plt.show()\n",
        "\n",
        "fig, axs = plt.subplots(2, 2, figsize=(14,10))\n",
        "\n",
        "# Top pilotos\n",
        "points_2023.head(5).plot(kind=\"bar\", ax=axs[0,0], title=\"Top Pilotos\")\n",
        "\n",
        "# Top constructores\n",
        "constructor_points.head(5).plot(kind=\"bar\", ax=axs[0,1], title=\"Top Constructores\")\n",
        "\n",
        "# Posiciones promedio\n",
        "avg_positions.head(5).plot(kind=\"bar\", ax=axs[1,0], title=\"Mejor Posición Promedio\")\n",
        "\n",
        "# Pit stops\n",
        "pit_avg.plot(ax=axs[1,1], title=\"Pit Stops por Carrera\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
